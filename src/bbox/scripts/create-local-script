#!/bin/bash
set -euo pipefail

name=${1:?Usage: create-local-script <name> [python]}
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || { echo "Invalid command name" >&2; exit 1; }
repo=${BBOX_SOURCE_DIR:-$HOME/Develop/bogit/bbox}
[[ -f "$repo/pyproject.toml" ]] || { echo "Clone bbox and set BBOX_SOURCE_DIR to its checkout." >&2; exit 1; }
if [[ ${2:-} == python ]]; then
    module=${name//-/_}
    file="$repo/src/bbox/$module.py"
    entry="bbox.$module:main"
    content=$'def main():\n    pass\n'
else
    file="$repo/src/bbox/scripts/$name"
    entry="bbox.shell:main"
    content=$'#!/bin/bash\nset -euo pipefail\n'
fi
(set -o noclobber; printf '%s' "$content" > "$file")
printf 'Created %s\nAdd this entry under [project.scripts] in pyproject.toml:\n%s = "%s"\nThen run: uv tool install --editable "%s"\n' "$file" "$name" "$entry" "$repo"
if command -v code >/dev/null 2>&1; then code "$file"; fi
